# ── Adzuna API ───────────────────────────────────────────────
# Free instant signup: https://developer.adzuna.com/
ADZUNA_APP_ID= app_id
ADZUNA_APP_KEY= app_key

# Comma-separated Adzuna country codes to collect from.
# Supported: gb, us, at, au, br, ca, de, fr, in, it, mx, nl, pl, ru, sg, za
ADZUNA_COUNTRIES=gb,us

SEARCH_TEXT=data analyst
RESULTS_PER_PAGE=50
TEST_MODE=false
MAX_PAGES_TEST=2
REQUEST_DELAY=0.3

# ── Database (SQLite file, no server needed) ────────────────
DB_NAME=headhunter

# ── Output ───────────────────────────────────────────────────
OUTPUT_DIR=output
LOG_LEVEL=INFO
